{
  "name": "gods-eye-view-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Unsigned Electron packaging for God's Eye View",
  "type": "module",
  "scripts": {
    "stage": "node stage.mjs",
    "dist": "node dist.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.seuput0705.gods-eye-view",
    "productName": "God's Eye View",
    "copyright": "Copyright (c) 2026 Bilawal Sidhu",
    "artifactName": "gods-eye-view-${version}-${os}-${arch}.${ext}",
    "directories": {
      "app": ".stage",
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "../public/icons/icon-512.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "God's Eye View uses the microphone for hands-free voice control."
      }
    },
    "win": {
      "icon": "../public/icons/icon-512.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

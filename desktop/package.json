{
  "name": "gods-eye-view-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Unsigned Electron packaging for MGEV (My God's Eye View)",
  "type": "module",
  "scripts": {
    "stage": "node stage.mjs",
    "dist": "node dist.mjs",
    "icons": "node icons.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.seuput0705.mgev",
    "productName": "MGEV",
    "copyright": "Copyright (c) 2026 Bilawal Sidhu",
    "artifactName": "MGEV-${os}-${arch}.${ext}",
    "directories": {
      "app": ".stage",
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "electronLanguages": [
      "en",
      "ko"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icons/icon.png",
      "identity": null,
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MGEV uses the microphone for hands-free voice control."
      }
    },
    "dmg": {
      "title": "MGEV"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MGEV"
    }
  }
}
